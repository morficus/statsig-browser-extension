# Copy to planning/phase0/.env (git-ignored) and run chmod 600 on it. Never commit the copy.

# Your Personal Console Key, with write access. Every step but t5-401 needs it.
STATSIG_CONSOLE_KEY=
# The test experiment name (the path id). It must start with intake_ext_phase0_. Every step but t5-401 needs it.
EXPERIMENT=
# The test experiment in the test layer (its ID). It must be in the layer LAYER_ID and not started. For t3-layer and cleanup.
LAYER_EXPERIMENT=
# The layerID that preflight prints for LAYER_EXPERIMENT. Copy it in. It must start with intake_ext_phase0_. For t3-layer and cleanup.
LAYER_ID=
# Your Stable ID on staging. The T4 snippet prints it. For t3-*, t5-403, and cleanup.
STABLE_ID=
# The exact Console environment name for the overrides (e.g. the staging environment). For t3-*, t5-403, and cleanup.
ENVIRONMENT=
# The first group name. Group names are the override key (groupID / groupName, WL-016). For t3-* and t5-403.
GROUP_A=Control
# The second group name. For t3-*.
GROUP_B=Test
# A made-up "other person" ID, seeded into GROUP_A. For t3-* and cleanup.
OTHER_ID_A=phase0-other-id-a
# A made-up "other person" ID, seeded into GROUP_B. For t3-* and cleanup.
OTHER_ID_B=phase0-other-id-b
# A Console key with read-only access. If it is empty, t5-403 prints SKIP and exits 0.
READ_ONLY_KEY=
